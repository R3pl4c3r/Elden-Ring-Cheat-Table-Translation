                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{
  Lock onto a new enemy, check this box to add it as another ally. Auto-
  unchecks itself after.
}
[ENABLE]
{$lua}
if syntaxcheck then return end
local mr = memrec

local targetedEnemyRec = getAddressList().getMemoryRecordByID(601372)
if not targetedEnemyRec.Active then targetedEnemyRec.Active = true end
local recruitAllyRec = getAddressList().getMemoryRecordByID(1337320100)
if not recruitAllyRec.Active then recruitAllyRec.Active = true end

if not RecruitAlly_List or not RecruitAlly_AddCurrentTarget then
  print("Recruit as Ally: couldn't get the ally system running -- try enabling 'Targeted Enemy' above manually first.")
else
  RecruitAlly_AddCurrentTarget()
end
local t = createTimer(getMainForm())
t.Interval = 100
t.OnTimer = function(timer)
  mr.Active = false
  timer.destroy()
end
{$asm}
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337320103</ID>
                      <Description>"Dismiss Last Ally"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{
  Dismisses your most recently recruited ally. Uncheck "Recruit as Ally"
  above to dismiss everyone at once instead.
}
[ENABLE]
{$lua}
if syntaxcheck then return end
local mr = memrec
if not RecruitAlly_List or #RecruitAlly_List == 0 then
  print("Recruit as Ally: no allies to dismiss.")
else
  local ally = table.remove(RecruitAlly_List)
  pcall(function() writeBytes(ally.AllianceAddr, ally.OldAlliance) end)
  pcall(function() writeBytes(ally.FlagsAddr, ally.OldFlags) end)
  print("Recruit as Ally: dismissed 1 ally ("..#RecruitAlly_List.." remaining).")
  if #RecruitAlly_List == 0 then
    getAddressList().getMemoryRecordByID(1337320100).Active = false
  end
end
local t = createTimer(getMainForm())
t.Interval = 100
t.OnTimer = function(timer)
  mr.Active = false
  timer.destroy()
end
{$asm}
[DISABLE]
{$asm}
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337320107</ID>
                      <Description>"Ally Slot to Dismiss"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>4 Bytes</VariableType>
                      <Address>RecruitAllySlotMem</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337320106</ID>
                      <Description>"Dismiss Ally By Slot"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{
  Set "Ally Slot to Dismiss" to the slot number (shown in the Lua log when
  recruited), then check this box to dismiss that one specifically.
}
[ENABLE]
{$lua}
if syntaxcheck then return end
local mr = memrec
if not RecruitAlly_List or #RecruitAlly_List == 0 then
  print("Recruit as Ally: no allies to dismiss.")
else
  local okSlot, slotNum = pcall(readInteger, "RecruitAllySlotMem")
  if not okSlot or not slotNum then slotNum = 1 end
  if slotNum &lt; 1 or slotNum &gt; #RecruitAlly_List then
    print("Recruit as Ally: no ally in slot #"..tostring(slotNum).." -- you currently have "..#RecruitAlly_List.." active ally/allies (valid slots: 1-"..#RecruitAlly_List..").")
  else
    local ally = table.remove(RecruitAlly_List, slotNum)
    pcall(function() writeBytes(ally.AllianceAddr, ally.OldAlliance) end)
    pcall(function() writeBytes(ally.FlagsAddr, ally.OldFlags) end)
    print("Recruit as Ally: dismissed ally slot #"..slotNum.." ("..#RecruitAlly_List.." remaining).")
    if #RecruitAlly_List == 0 then
      getAddressList().getMemoryRecordByID(1337320100).Active = false
    end
  end
end
local t = createTimer(getMainForm())
t.Interval = 100
t.OnTimer = function(timer)
  mr.Active = false
  timer.destroy()
end
