                              <CheatEntries>
                                <CheatEntry>
                                  <ID>1987706527</ID>
                                  <Description>"Play Behavior Name"</Description>
                                  <Options moHideChildren="1"/>
                                  <VariableType>Auto Assembler Script</VariableType>
                                  <AssemblerScript>[ENABLE]
alloc(PlayAnimTest,256,eldenring.exe)
registersymbol(PlayAnimTest)

aobscanmodule(PlayAnimCall_,eldenring.exe,40 53 48 83 EC ?? 48 83 39 00 48 8B D9 ?? ?? 48 85 D2)
registersymbol(PlayAnimCall_)

alloc(AnimString,128)
registersymbol(AnimString)

AnimString:
  db 57 00 5F 00 41 00 74 00 74 00 61 00 63 00 6B 00 33 00 30 00 30 00 30 00

PlayAnimTest:
mov rcx,[SpawnedEnemy]
mov rcx,[rcx+190]
mov rcx,[rcx+28]
mov rcx,[rcx+10]
lea rcx,[rcx+30]
lea rdx,[AnimString]
sub rsp,28
call PlayAnimCall_
add rsp,28
ret

[DISABLE]
dealloc(PlayAnimTest)
unregistersymbol(PlayAnimTest)

dealloc(AnimString)
unregistersymbol(AnimString)

unregistersymbol(PlayAnimCall_)
</AssemblerScript>
