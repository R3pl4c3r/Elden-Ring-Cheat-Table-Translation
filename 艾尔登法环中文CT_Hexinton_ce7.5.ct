                </CheatEntry>
                <CheatEntry>
                  <ID>1337271259</ID>
                  <Description>"设置圣杯瓶等级"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local addr = {
    GetTotalBonfireLevel = 0x0,
    ActivateBonfire = AOBScanModuleUnique(process, "88 4c ?? ?? 53 ?? 83 ec ?? c6 44 ?? ?? 63 c6 44 ?? ?? 01 80 f9 01"),
    ReplaceTool = AOBScanModuleUnique(process, "?? 0f b6 f1 ?? 8b d8 ?? 8b f9 81 e2 ff ff ff 0f 0f ba ea ?? 89 54 ?? ?? ?? 81 c1") - 0x19,
}

addr.GetTotalBonfireLevel = addr.ActivateBonfire + 0x3C + readInteger(addr.ActivateBonfire + 0x3C + 2, 1) + 6

local function getTotalBonfireLevel()
    return readByte(addr.GetTotalBonfireLevel)
end

local function activateBonfire(bonfireLv)
    executeCode(addr.ActivateBonfire, bonfireLv)
end

local function replaceTool(equipGameData, currentId, replaceId)
    executeCodeEx(0, 100, addr.ReplaceTool, equipGameData, currentId, replaceId, 1)
end

local function saveRequest()
    local gameMan = getPointer("GameMan")
    writeByte(gameMan + 0xB42, 1)
end

local function replaceFlasks(newFlaskLv)
    local gameDataMan = readPointer("GameDataMan")
    local playerGameData = readPointer(gameDataMan + 0x8)
    local equipGameData = getAddress(playerGameData + 0x2B0)
    local flaskLv = getTotalBonfireLevel() - 1
    local flaskIds = {1000, 1001, 1050, 1051}

    for _, v in ipairs(flaskIds) do
        local oldItem = v + flaskLv * 2
        local newItem = v + (newFlaskLv - 1) * 2
        if oldItem ~= newItem then
            replaceTool(equipGameData, oldItem, newItem)
        end
    end
end

local function setBonfireLv(bonfireLv)
    bonfireLv = math.max(1, math.min(bonfireLv, 13))

    if getTotalBonfireLevel() &lt;= 13 then
        replaceFlasks(bonfireLv)
        activateBonfire(bonfireLv)
        saveRequest()
    end
end

local bonfireLv = inputQuery("Set Flask Level", "Should be between 0 and 12", getTotalBonfireLevel() - 1)
if bonfireLv then
    setBonfireLv(tonumber(bonfireLv) + 1)
end

disableMemrec(memrec)

[DISABLE]

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337271279</ID>
                  <Description>"将圣杯瓶充能添加到最大"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]

local estusAllocationUpdateAddr = AOBScanModuleUnique(process, "?? 8b ?? ?? ?? ?? ?? ?? 8b c1 ?? 8b ?? ?? ?? 85 c9 74 ?? ?? 85 c0 74 ?? ?? 83 f8 01 75 ?? 0f b6")

local function getEstusAllocation(flaskType)
    local gameDataMan = readPointer("GameDataMan")
    local playerGameData = readPointer(gameDataMan + 0x8)
    if flaskType == 0 then
        return readByte(playerGameData + 0x101) -- EstusFlaskAllocateNum_byHp
    else
        return readByte(playerGameData + 0x102) -- EstusFlaskAllocateNum_byMp
    end
end

local function updateEstusAllocation(newQuantity, flaskType)
    executeCodeEx(0, 100, estusAllocationUpdateAddr, flaskType, newQuantity)
end

local hpFlaskAllocation = getEstusAllocation(0)
local mpFlaskAllocation = getEstusAllocation(1)

if hpFlaskAllocation + mpFlaskAllocation &lt;= 13 then
    updateEstusAllocation(hpFlaskAllocation + 1, 0)
    if tga.config.printProgress then
        showMessage("Added a charge to Flask of Crimson Tears")
    end
else
    showMessage("Flask charges already at maximum")
end

disableMemrec(memrec)

[DISABLE]

</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
