                <CheatEntry>
                  <ID>1337271236</ID>
                  <Description>"打开游戏内功能菜单"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{Author: inuFurry luv Pappy Lukey}

{$lua}
if syntaxcheck then return end

[ENABLE]

local function initav()
    local game_addr = getAddressSafe(process)
    if not game_addr then error("Process address not found", 2) end
    local fun_addr = 0
    local fun_ver = "2.02"
    return game_addr, fun_addr, fun_ver
end

function BonfireMenu(menu)
    local game_addr, fun_addr, fun_ver = initav()
    if not menu then error("No menu specified", 2) end

    local menu_addresses = {
        [0] = game_addr + 0x80f600 + 0x3d0, -- Memorize Spells
        [1] = game_addr + 0x8104c0 + 0x3d0, -- Sort Chest
        [2] = game_addr + 0x810160 + 0x3d0, -- Level Up
        [3] = game_addr + 0x80eee0 + 0x3d0, -- Ashes of War
        [4] = game_addr + 0x80e080 + 0x3d0, -- Flask Allocation
        [5] = game_addr + 0x80de30 + 0x3d0, -- Wondrous Physick Mix
        [6] = game_addr + 0x80d940 + 0x3d0  -- Great Runes
    }

    fun_addr = menu_addresses[menu]
    if not fun_addr then error("Invalid menu", 2) end

    executeCodeEx(0, 100, fun_addr, "")
end

function NpcMenu(menu)
    local game_addr, fun_addr, fun_ver = initav()
    if not menu then error("No menu specified", 2) end

    local menu_addresses = {
        [0] = game_addr + 0x810bc0 + 0x3d0, -- Rebirth
        [1] = game_addr + 0x80dc00 + 0x3d0, -- Cosmetics (Rennala)
        [2] = game_addr + 0x80dcb0 + 0x3d0, -- Cosmetics (Mirror)
        [3] = game_addr + 0x80daf0 + 0x3d0, -- Spirit Tuning
        [4] = game_addr + 0x80ebb0 + 0x3d0, -- Blacksmith
        [5] = game_addr + 0x80f4f0 + 0x3d0, -- Smithing Table
        [6] = game_addr + 0x80edd0 + 0x3d0  -- Sell Item
    }

    fun_addr = menu_addresses[menu]
    if not fun_addr then error("Invalid menu", 2) end

    local var1, mem
    if menu == 5 then
        var1 = 3
    elseif menu == 6 then
        mem = allocateMemory(0x40, game_addr)
        var1 = mem
    end

    if var1 then
        executeCodeEx(0, 100, fun_addr, "", var1)
        if mem then deAlloc(mem) end
    else
        executeCodeEx(0, 100, fun_addr, "")
    end
end

function ShopMenu(startId, endId, shopType)
    local game_addr, fun_addr, fun_ver = initav()
    startId = startId or 0
    endId = endId or startId + 99

    local shop_addresses = {
        [0] = game_addr + 0x80e770, -- Purchase Item
        [1] = game_addr + 0x810920, -- Power of Remembrance
        [2] = game_addr + 0x80e8c0, -- GR_MenuText(237000)
        [3] = game_addr + 0x810a70, -- Dragon Communion
        [4] = game_addr + 0x810220, -- Alter Garments
        [5] = game_addr + 0x80df30, -- Ash of War Duplication
        [6] = game_addr + 0x810370, -- Puppet (Starlight Shards)
        [7] = game_addr + 0x8107d0, -- GR_MenuText(228000)
        [8] = game_addr + 0x80e660, -- Puppet
        [9] = game_addr + 0x80e550, -- Remembrance Duplication
        [10] = game_addr + 0x80e400 -- Equipment of Champions
    }

    fun_addr = shop_addresses[shopType or 0]
    if not fun_addr then error("Invalid shop type", 2) end

    local mem = allocateMemory(0xA0, game_addr)
    executeCodeEx(0, 100, fun_addr, "", startId, endId, mem)
    deAlloc(mem)
end

-- Convenience functions for specific shop menus
function ShopMenu_remembrance(startId, endId) ShopMenu(startId, endId, 1) end
function ShopMenu_dragon(startId, endId) ShopMenu(startId, endId, 3) end
function ShopMenu_alter(startId, endId) ShopMenu(startId, endId, 4) end
function ShopMenu_gem(startId, endId) ShopMenu(startId, endId, 5) end
function ShopMenu_shards(startId, endId) ShopMenu(startId, endId, 6) end
function ShopMenu_puppet(startId, endId) ShopMenu(startId, endId, 8) end
function ShopMenu_duplicate(startId, endId) ShopMenu(startId, endId, 9) end
function ShopMenu_champion(startId, endId) ShopMenu(startId, endId, 10) end

[DISABLE]

BonfireMenu = nil
NpcMenu = nil
ShopMenu = nil
ShopMenu_remembrance = nil
ShopMenu_dragon = nil
ShopMenu_alter = nil
ShopMenu_gem = nil
ShopMenu_shards = nil
ShopMenu_puppet = nil
ShopMenu_duplicate = nil
ShopMenu_champion = nil

</AssemblerScript>
