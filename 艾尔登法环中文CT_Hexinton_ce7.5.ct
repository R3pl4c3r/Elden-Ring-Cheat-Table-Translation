        <CheatEntry>
          <ID>1337209393</ID>
          <Description>"[ NPC ]"</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>601372</ID>
              <Description>"目标敌人"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
-- fixes leftover hook if the table wasn't closed cleanly last time
if not syntaxcheck then
  local origBytes = "48 8B 48 08 49 89 8D B0 06 00 00 49 8B CE E8"
  local tailBytes  = "89 8D B0 06 00 00 49 8B CE E8"
  if not AOBScanModuleUnique("eldenring.exe", origBytes, "+X") then
    local tailAddr = AOBScanModuleUnique("eldenring.exe", tailBytes, "+X")
    if tailAddr then
      local hookAddr = tailAddr - 5
      local firstByte = readBytes(hookAddr, 1, true)[1]
      if firstByte == 0xE9 then
        writeBytes(hookAddr, {0x48, 0x8B, 0x48, 0x08, 0x49})
        print("Targeted Enemy: cleaned up a leftover hook from a previous session -- no restart needed.")
      end
    end
  end
end
local addr=AOBScanModuleUnique("eldenring.exe","48 89 44 24 50 48 8B D9 C7 44 24 24 00 00 00 00 48 8B 0D","+X")
if addr then
   registerSymbol("CameraBase",addr+23+readInteger(addr+19,true),true)
end

if not syntaxcheck then
  if not getAddressSafe("RecruitAllyRangeMem") then
    local rangeMem = allocateMemory(4)
    writeInteger(rangeMem, 25)
    registerSymbol("RecruitAllyRangeMem", rangeMem, true)
  end
end

if not syntaxcheck then
  if not getAddressSafe("RecruitAllySlotMem") then
    local slotMem = allocateMemory(4)
    writeInteger(slotMem, 1)
    registerSymbol("RecruitAllySlotMem", slotMem, true)
  end
end
{$asm}
aobScanModule(LockOnTarget_accessor,eldenring.exe,48 8B 48 08 49 89 8D B0 06 00 00 49 8B CE E8)
alloc(LastLockOnTarget,4096,LockOnTarget_accessor)
registersymbol(LastLockOnTarget)
LastLockOnTarget:
dq 0
LockOnHook:
mov [LastLockOnTarget],rax
mov rcx,[rax+08]
mov [r13+000006B0],rcx
jmp LockOnTarget_accessor+B

LockOnTarget_accessor:
jmp LockOnHook

[DISABLE]
LockOnTarget_accessor:
db 48 8B 48 08 49 89 8D B0 06 00 00 49 8B CE E8
dealloc(LastLockOnTarget)
unregistersymbol(LastLockOnTarget)
{$lua}
if not syntaxcheck then
  local rangeMem = getAddressSafe("RecruitAllyRangeMem")
  if rangeMem then
    unregisterSymbol("RecruitAllyRangeMem")
    deAlloc(rangeMem)
  end
  local slotMem = getAddressSafe("RecruitAllySlotMem")
  if slotMem then
    unregisterSymbol("RecruitAllySlotMem")
    deAlloc(slotMem)
  end
end
{$asm}
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>5533</ID>
                  <Description>"额外锁定射程 Extra Lock on Range"</Description>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>Float</VariableType>
                  <Address>[CameraBase]+2924</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337320100</ID>
                  <Description>"Recruit Target as Ally (Fights &amp; Follows Like a Mimic Tear)"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  On/off switch for the ally system. Recruits whatever you have locked on
  when you check it (or starts empty if nothing's targeted). Use "Add Ally"
  or "Spawn &amp; Recruit Enemy" below to add more. Uncheck to dismiss everyone.
}
[ENABLE]
{$lua}
if syntaxcheck then return end

function RecruitAlly_AddCurrentTarget(silent)
  local okLock, lockPtr = pcall(readQword, "LastLockOnTarget")
  if not okLock or not lockPtr or lockPtr == 0 then
    print("Recruit as Ally: nothing locked on (or 'Targeted Enemy' above isn't checked). Enable 'Targeted Enemy', lock onto the enemy you want, then check this box (or 'Add Ally' if you already have allies).")
    return false
  end

  local allianceAddr = getAddressList().getMemoryRecordByID(601377).getCurrentAddress()
  local flagsAddr    = getAddressList().getMemoryRecordByID(1337199547).getCurrentAddress() -- NoDead=bit0, NoDamage=bit1

  if not allianceAddr or allianceAddr == 0 or not flagsAddr or flagsAddr == 0 then
    if not silent then print("Recruit as Ally: could not resolve that target's data yet. Try again.") end
    return false, true
  end

  for _, ally in ipairs(RecruitAlly_List) do
    if ally.AllianceAddr == allianceAddr then
      print("Recruit as Ally: that target is already one of your allies.")
      return false, false
    end
  end

  local okOldA, oldAllianceBytes = pcall(readBytes, allianceAddr, 1, true)
  local okOldF, oldFlagsBytes    = pcall(readBytes, flagsAddr, 1, true)
  if not okOldA or not oldAllianceBytes or not okOldF or not oldFlagsBytes then
    if not silent then print("Recruit as Ally: could not read that target's data yet. Try again.") end
    return false, true
  end
  local oldAlliance = oldAllianceBytes[1]
  local oldFlags    = oldFlagsBytes[1]

  local okWriteA = pcall(writeBytes, allianceAddr, 47) -- Spirit Summon team
  if not okWriteA then
    if not silent then print("Recruit as Ally: could not write that target's data yet. Try again.") end
    return false, true
  end

  local newFlags = oldFlags
  if newFlags % 2 &lt; 1 then newFlags = newFlags + 1 end -- NoDead
  if newFlags % 4 &lt; 2 then newFlags = newFlags + 2 end -- NoDamage
  writeBytes(flagsAddr, newFlags)

  table.insert(RecruitAlly_List, {
    AllianceAddr  = allianceAddr,
    FlagsAddr     = flagsAddr,
    BasePtr       = lockPtr,
    PosGraceTicks = 3,
    OldAlliance   = oldAlliance,
    OldFlags      = oldFlags,
  })

  print("Recruit as Ally: recruited as ally slot #"..#RecruitAlly_List.." ("..#RecruitAlly_List.." active total).")
  return true
end

local function RecruitAlly_ResolvePos(basePtr)
  if not basePtr or basePtr == 0 then return nil, nil end
  local ok1, p1 = pcall(readQword, basePtr + 0x190)
  if not ok1 or not p1 or p1 == 0 then return nil, nil end
  local ok2, p2 = pcall(readQword, p1 + 0x68)
  if not ok2 or not p2 or p2 == 0 then return nil, nil end
  local posAddr = p2 + 0x70
  local pos2Addr = nil
  local ok3, p3 = pcall(readQword, p2 + 0xA8)
  if ok3 and p3 and p3 ~= 0 then
    local ok4, p4 = pcall(readQword, p3 + 0x18)
    if ok4 and p4 and p4 ~= 0 then
      pos2Addr = p4 + 0x80
    end
  end
  return posAddr, pos2Addr
end

RecruitAlly_List = RecruitAlly_List or {}
if RecruitAlly_Timer == nil then
  local okLock, lockPtr = pcall(readQword, "LastLockOnTarget")
  if okLock and lockPtr and lockPtr ~= 0 then
    RecruitAlly_AddCurrentTarget()
  end
end

if RecruitAlly_Timer == nil then
  local RECRUITALLY_RANGE_FALLBACK = 25
  local everHadAny = false
  RecruitAlly_Timer = createTimer(nil)
  RecruitAlly_Timer.Interval = 1500
  RecruitAlly_Timer.OnTimer = function(t)
    local px = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+70")
    local py = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+74")
    local pz = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+78")

    local rangeOk, range = pcall(readInteger, "RecruitAllyRangeMem")
    if not rangeOk or not range or range &lt;= 0 then range = RECRUITALLY_RANGE_FALLBACK end

    local i = 1
    while i &lt;= #RecruitAlly_List do
      local ally = RecruitAlly_List[i]
      local posAddr, pos2Addr = RecruitAlly_ResolvePos(ally.BasePtr)
      local ok = posAddr ~= nil and pcall(function()
        local ax = readFloat(posAddr)
        local ay = readFloat(posAddr+4)
        local az = readFloat(posAddr+8)
        local d = math.sqrt((px-ax)*(px-ax) + (py-ay)*(py-ay) + (pz-az)*(pz-az))
        if d ~= d or d &gt; 100000 then
          error("ally gone")
        end
        if d &gt; range then
          writeFloat(posAddr, px)
          writeFloat(posAddr+4, py)
          writeFloat(posAddr+8, pz)
          if pos2Addr then
            writeFloat(pos2Addr, px)
            writeFloat(pos2Addr+4, py)
            writeFloat(pos2Addr+8, pz)
          end
        end
      end)
      if ok then
        ally.PosGraceTicks = 3
        i = i + 1
      else
        ally.PosGraceTicks = (ally.PosGraceTicks or 0) - 1
        if ally.PosGraceTicks &gt; 0 then
          i = i + 1
        else
          table.remove(RecruitAlly_List, i)
        end
      end
    end

    if #RecruitAlly_List &gt; 0 then
      everHadAny = true
    elseif everHadAny then
      print("Recruit as Ally: lost track of all your allies (despawned, died, or you changed areas) -- turning this off. Lock onto a new one and re-check the box to recruit again.")
      getAddressList().getMemoryRecordByID(1337320100).Active = false
    end
  end
  RecruitAlly_Timer.Enabled = true
end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if RecruitAlly_Timer then
  RecruitAlly_Timer.destroy()
  RecruitAlly_Timer = nil
end
if RecruitAlly_List then
  for _, ally in ipairs(RecruitAlly_List) do
    pcall(function() writeBytes(ally.AllianceAddr, ally.OldAlliance) end)
    pcall(function() writeBytes(ally.FlagsAddr, ally.OldFlags) end)
  end
end
RecruitAlly_List = nil
print("Recruit as Ally: dismissed.")
{$asm}
</AssemblerScript>
