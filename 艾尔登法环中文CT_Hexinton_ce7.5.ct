                        <CheatEntry>
                          <ID>1337320105</ID>
                          <Description>"Spawn &amp; Recruit Enemy"</Description>
                          <VariableType>Auto Assembler Script</VariableType>
                          <AssemblerScript>{
  Pick an enemy from "Enemy to Spawn" above, check this box to spawn it and
  auto-recruit it once you lock on. Turns on Targeted Enemy/Recruit as
  Ally/Character Spawner itself if needed. Avoid c2070 (The Three Fingers)
  -- it crashes the game.
}
[ENABLE]
{$lua}
if syntaxcheck then return end
local mr = memrec

local function selfUncheckSoon()
  local t = createTimer(getMainForm())
  t.Interval = 100
  t.OnTimer = function(timer)
    mr.Active = false
    timer.destroy()
  end
end

local chrId = getAddressList().getMemoryRecordByID(1337320104).Value
local digits = chrId and chrId:match("^c(%d+)$")
if not digits then
  print("Spawn &amp; Recruit Enemy: pick a boss/enemy from the 'Enemy to Spawn' dropdown above first -- '"..tostring(chrId).."' doesn't look like a valid pick.")
  selfUncheckSoon()
  return
end
local paramValue = tonumber(digits.."0000")

local targetedEnemyRec = getAddressList().getMemoryRecordByID(601372)
if not targetedEnemyRec.Active then targetedEnemyRec.Active = true end
local recruitAllyRec = getAddressList().getMemoryRecordByID(1337320100)
if not recruitAllyRec.Active then recruitAllyRec.Active = true end
local spawnerOuterRec = getAddressList().getMemoryRecordByID(1987705401)
if not spawnerOuterRec.Active then spawnerOuterRec.Active = true end
local spawnerInnerRec = getAddressList().getMemoryRecordByID(1987705402)
if not spawnerInnerRec.Active then spawnerInnerRec.Active = true end

if not RecruitAlly_List or not RecruitAlly_AddCurrentTarget then
  print("Spawn &amp; Recruit Enemy: couldn't get the ally system running -- try enabling 'Targeted Enemy' above manually first.")
  selfUncheckSoon()
  return
end

writeInteger(getAddressList().getMemoryRecordByID(1987705425).getCurrentAddress(), paramValue) -- NpcParamID
writeInteger(getAddressList().getMemoryRecordByID(1987705426).getCurrentAddress(), paramValue) -- NpcThinkParamID
writeBytes(getAddressList().getMemoryRecordByID(1987705420).getCurrentAddress(), 0) -- EnemyType
writeInteger(getAddressList().getMemoryRecordByID(1987705432).getCurrentAddress(), 0) -- SpawnManipulatorType

local px = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+70")
local py = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+74")
local pz = readFloat("[[[[[WorldChrMan]+10EF8]+0]+190]+68]+78")
writeFloat(getAddressList().getMemoryRecordByID(1987705435).getCurrentAddress(), px) -- SpawnPosX
writeFloat(getAddressList().getMemoryRecordByID(1987705436).getCurrentAddress(), py) -- SpawnPosY
writeFloat(getAddressList().getMemoryRecordByID(1987705437).getCurrentAddress(), pz) -- SpawnPosZ

local okPrevSpawn, prevSpawnedPtr = pcall(readQword, "SpawnedEnemy")
if not okPrevSpawn then prevSpawnedPtr = nil end

getAddressList().getMemoryRecordByID(1987705439).Active = true

local attemptsLeft = 50
local spawnedPtr = nil
local printTicksUntilNext = nil
local recruitCyclesLeft = nil
local pollTimer = createTimer(getMainForm())
pollTimer.Interval = 100
pollTimer.OnTimer = function(timer)
  if GetPtr_3 then pcall(GetPtr_3) end

  if not spawnedPtr then
    attemptsLeft = attemptsLeft - 1
    local okSpawn, curSpawnedPtr = pcall(readQword, "SpawnedEnemy")
    if okSpawn and curSpawnedPtr and curSpawnedPtr ~= 0 and curSpawnedPtr ~= prevSpawnedPtr then
      spawnedPtr = curSpawnedPtr
      printTicksUntilNext = 0
      recruitCyclesLeft = 60
    elseif attemptsLeft &gt; 0 then
      return
    else
      timer.destroy()
      print("Spawn &amp; Recruit Enemy: the spawn didn't register in time -- try again, or lock onto it manually in-game and use 'Add Ally' instead.")
      mr.Active = false
      return
    end
  end

  local okCur, curLockPtr = pcall(readQword, "LastLockOnTarget")
  local recruitedOk, retryable = false, true
  if okCur and curLockPtr == spawnedPtr then
    recruitedOk, retryable = RecruitAlly_AddCurrentTarget(true)
  end

  if recruitedOk then
    timer.destroy()
    local justRecruited = RecruitAlly_List[#RecruitAlly_List]
    local reassertsLeft = 3
    local reassertTimer = createTimer(getMainForm())
    reassertTimer.Interval = 500
    reassertTimer.OnTimer = function(rtimer)
      reassertsLeft = reassertsLeft - 1
      local stillAnAlly = false
      if RecruitAlly_List then
        for _, a in ipairs(RecruitAlly_List) do
          if a == justRecruited then stillAnAlly = true; break end
        end
      end
      if stillAnAlly then
        pcall(function()
          writeBytes(justRecruited.AllianceAddr, 47)
          local curFlags = readBytes(justRecruited.FlagsAddr, 1, true)[1]
          local wantFlags = curFlags
          if wantFlags % 2 &lt; 1 then wantFlags = wantFlags + 1 end
          if wantFlags % 4 &lt; 2 then wantFlags = wantFlags + 2 end
          writeBytes(justRecruited.FlagsAddr, wantFlags)
        end)
      end
      if reassertsLeft &lt;= 0 or not stillAnAlly then
        rtimer.destroy()
      end
    end
    mr.Active = false
  elseif not retryable then
    timer.destroy()
    mr.Active = false
    return
  end

  printTicksUntilNext = printTicksUntilNext - 1
  if printTicksUntilNext &gt; 0 then
    return
  end
  printTicksUntilNext = 20
  recruitCyclesLeft = recruitCyclesLeft - 1
  if recruitCyclesLeft &gt; 0 then
    print("Spawn &amp; Recruit Enemy: spawned -- lock onto it to finish recruiting.")
  else
    timer.destroy()
    print("Spawn &amp; Recruit Enemy: still couldn't add it as an ally -- lock onto it and use 'Add Ally' manually.")
    mr.Active = false
  end
end
{$asm}
