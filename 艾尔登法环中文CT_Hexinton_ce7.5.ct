function SaveWindowState(form, key)
pcall(function()
    local path = os.getenv("TEMP").."\\EldenRingCETable_WindowState.ini"
    local kept = {}
    local f = io.open(path, "r")
    if f then
        for line in f:lines() do
            if not line:match("^"..key.."=") then
                table.insert(kept, line)
            end
        end
        f:close()
    end
    table.insert(kept, string.format("%s=%d,%d,%d,%d", key, form.Left, form.Top, form.Width, form.Height))
    local out = io.open(path, "w")
    if out then
        for _, line in ipairs(kept) do
            out:write(line.."\n")
        end
        out:close()
    end
end)
end

function LoadWindowState(form, key, defLeft, defTop, defWidth, defHeight)
-- bounds widened on the negative side (old -100/-50 floor rejected legit left/above
-- secondary-monitor positions), width/height capped to one 4K display (old 5000x4000
-- cap was bigger than any real screen). centerScreen() fallback guarantees the window
-- is visible on-screen whenever no valid saved position applies.
local applied = false
pcall(function()
    local path = os.getenv("TEMP").."\\EldenRingCETable_WindowState.ini"
    local f = io.open(path, "r")
    if f then
        for line in f:lines() do
            local k, l, t, w, h = line:match("^(.-)=(-?%d+),(-?%d+),(%d+),(%d+)$")
            if k == key then
                l, t, w, h = tonumber(l), tonumber(t), tonumber(w), tonumber(h)
                if w and h and w &gt;= 200 and h &gt;= 150 and w &lt;= 3840 and h &lt;= 2160
                   and l and l &gt;= -4000 and l &lt;= 8000 and t and t &gt;= -2000 and t &lt;= 5000 then
                    form.Left, form.Top, form.Width, form.Height = l, t, w, h
                    applied = true
                end
            end
        end
        f:close()
    end
end)
if not applied then
    form.Left, form.Top, form.Width, form.Height = defLeft, defTop, defWidth, defHeight
    pcall(function() form.centerScreen() end)
end
return applied
end

function ItemGib_FormClose(sender)
ItemGib.CEListView1.beginUpdate()
ItemGib.CEListView1.Items.Clear()
ItemGib.CEListView1.endUpdate()
SaveWindowState(ItemGib, "ItemGib")
return caHide --Possible options: caHide, caFree, caMinimize, caNone
end


