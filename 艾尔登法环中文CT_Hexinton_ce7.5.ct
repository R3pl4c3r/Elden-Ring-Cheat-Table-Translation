          <CheatEntries>
            <CheatEntry>
              <ID>1337318035</ID>
              <Description>"Reset Window Positions"</Description>
              <Color>FF8000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//Reset Window Positions - Team Hexinton
//Checkbox utility: deletes the saved window-position file so every remembered popup
//(Item Gib, Inventory Editor, Attack/Effect/Bullet Logger, Flags Monitor, NPC Manager)
//goes back to its default size/position and centers on screen next time it opens.
//Use this if a window ever opens off-screen or unreachable.
{$LUA}
if syntaxcheck then return end
[ENABLE]
local path = os.getenv("TEMP") .. "\\EldenRingCETable_WindowState.ini"
os.remove(path) -- no-op if nothing was saved yet, that still counts as reset
local stillThere = io.open(path, "r")
if stillThere then
    stillThere:close()
    messageDialog("Could not reset window positions - the file may be in use or read-only:\n" .. path, mtError, mbOK)
else
    messageDialog("Window positions reset. Popups will use their default size/position and center on screen next time they're opened.", mtInformation, mbOK)
end

local selfEntry = getAddressList().getMemoryRecordByID(1337318035)
local t = createTimer(getMainForm())
t.Interval = 128
t.OnTimer = function(timer)
    selfEntry.Active = false
    timer.destroy()
end
[DISABLE]
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
