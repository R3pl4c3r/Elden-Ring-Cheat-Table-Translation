                    <CheatEntry>
                      <ID>1337193281</ID>
                      <Description>"战灰"</Description>
                      <DropDownListLink>AshofWarDropdown</DropDownListLink>
                      <ShowAsHex>1</ShowAsHex>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>4 Bytes</VariableType>
