writeInteger("set_morning",1)
local timer = createTimer(nil, false)
timer.Interval = 1000  -- time in Milisecond 1000 msec = 1 sec
timer.OnTimer = function(timer)
    timer.Enabled = false
    timer.destroy()
    memrec.Active = false --Disactivate this script
end
-- After 2 sec from the script activate
timer.Enabled = true

