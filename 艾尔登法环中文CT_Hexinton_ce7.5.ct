local ids = {
33130000,33000000,33040000,33050000,33060000,33090000,33120000,33170000,33180000,
33190000,33200000,33210000,33230000,33240000,33250000,33260000,33270000,33280000,
34000000,34010000,34020000,34030000,34040000,34060000,34070000,34080000,34090000,
}

for i,id in ipairs(ids) do
local weapon = EquipParamWeapon:new("EverythingCastEverything", id)
