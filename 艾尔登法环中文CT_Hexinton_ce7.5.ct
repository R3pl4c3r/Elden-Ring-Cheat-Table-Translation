                  <Options moHideChildren="1"/>
                  <Color>C0C0C0</Color>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>601065</ID>
                      <Description>"物品类型（双击最后一列，下拉菜单里选择类型）"</Description>
                      <DropDownList DisplayValueAsItem="1">0:武器
