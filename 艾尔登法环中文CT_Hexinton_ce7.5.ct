                <CheatEntry>
                  <ID>22021410</ID>
                  <Description>"Peek Support"</Description>
                  <Options moAlwaysHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
AOBScanModule(CamFollow,eldenring.exe,48 33 C4 48 89 45 E0 49 8B F1 49 8B F8 48 8B D9 48 8D 55 80 49 8B C8 E8)
//AOBScanModule(CamFollow,eldenring.exe,4D 8B F9 49 8B D8 44 0F 28 F9 48 8B F1 4D 85 F6)
alloc(CamFollowAlt,4096)
registersymbol(CamFollowAlt)
CamFollowAlt:
dq 0

IsBadAddr:
cmp rdi,10000
jl @f
test rdi,7
jnz @f
push r9
push r8
push rdx
push rcx
mov edx,8
mov rcx,rdi
sub rsp,20
call IsBadReadPtr
add rsp,20
pop rcx
pop rdx
pop r8
pop r9
test eax,eax
ret
@@:
mov al,1
test eax,eax
ret

CamFollowHook:
xor rax,rsp
mov [rbp-20],rax
mov rsi,[CamFollowAlt]
mov rdi,rsi
call IsBadAddr
jne @f
mov rdi,[rsi]
mov rax,eldenring.exe
cmp rdi,rax
jle @f
add rax,57DF800
cmp rdi,rax
jae @f
call IsBadAddr
jne @f
lea rdi,[rsi+190]
call IsBadAddr
jne @f
mov rdi,[rdi]
add rdi,68
call IsBadAddr
jne @f
mov rdi,[rdi]
add rdi,70
call IsBadAddr
jne @f
mov r8,rsi
@@:
mov rsi,r9
mov rdi,r8
jmp CamFollow+D

CamFollow:
mov rsi,CamFollowHook
jmp rsi
[DISABLE]
CamFollow:
db 48 33 C4 48 89 45 E0 49 8B F1 49 8B F8 48 8B D9 48 8D 55 80 49 8B C8 E8
//db 4D 8B F9 49 8B D8 44 0F 28 F9 48 8B F1 4D 85 F6
dealloc(CamFollowAlt)
unregistersymbol(CamFollowAlt)
</AssemblerScript>
