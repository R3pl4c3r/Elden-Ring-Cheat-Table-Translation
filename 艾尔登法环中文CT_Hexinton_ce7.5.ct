local function getExeFilePath(addr,pid)
    local mods = enumModules(pid)
    for k,v in pairs(mods) do
        if v.Address == addr then return v.PathToFile end
    end
end
local function versionString(vernum)
    return string.format("%u.%u.%u.%u",(vernum&gt;&gt;48)&amp;65535,(vernum&gt;&gt;32)&amp;65535,(vernum&gt;&gt;16)&amp;65535,vernum&amp;65535)
end
local liveVersion = "unknown"
local okv, fp = pcall(getExeFilePath, getAddressSafe("eldenring.exe"), getOpenedProcessID())
if okv and fp then
    local vn = getFileVersion(fp)
    if vn then liveVersion = versionString(vn) end
end

-- IDs of features already parked in WIP and Outdated (or otherwise known-dead and
-- accepted). Update this list whenever something moves in/out of that group, so
-- Health Check stops crying wolf on stuff we already know about and new regressions
-- don't get buried in the noise.
local knownDeadIDs = {
    ["1337095320"] = true, -- Face Logger
    ["601366"] = true,     -- Magic No Requirements
    ["1337278739"] = true, -- Hit Collision Display
    ["3"] = true,          -- ItemQuantity
    ["5"] = true,          -- HighlightedItemFunc
}
local function labelIsKnown(label)
    for id in label:gmatch("%((%-?%d+)%)") do
        if knownDeadIDs[id] then return true end
    end
    return false
end

local passed, failedNew, failedKnown = {}, {}, {}
for _, c in ipairs(checks) do
    local ok = autoAssemble(string.format([[
        aobscanmodule(HealthCheckSym,%s,%s)
        registersymbol(HealthCheckSym)
    ]], c.module, c.pattern))
    if ok then
        unregisterSymbol("HealthCheckSym")
        table.insert(passed, c.label)
    elseif labelIsKnown(c.label) then
        table.insert(failedKnown, c.label)
    else
        table.insert(failedNew, c.label)
    end
end

local report = {}
table.insert(report, string.format("AOB HEALTH CHECK - %s", os.date("%Y-%m-%d %H:%M:%S")))
local tablever = 0x2000700010000 -- keep in sync with [ Enable ]'s tablever
table.insert(report, string.format("Live game FileVersion: %s  (table was built for %s)", liveVersion, versionString(tablever)))
table.insert(report, string.format("Checked %d patterns: %d OK, %d DEAD (%d new, %d known)", #checks, #passed, #failedNew+#failedKnown, #failedNew, #failedKnown))
table.insert(report, "")
if #failedNew &gt; 0 then
    table.insert(report, "===== NEEDS ATTENTION (new since last known state) =====")
    for _, name in ipairs(failedNew) do
        table.insert(report, "  [DEAD] " .. name)
    end
    table.insert(report, "")
else
    table.insert(report, "No new regressions.")
    table.insert(report, "")
end
if #failedKnown &gt; 0 then
    table.insert(report, "===== KNOWN DEAD (already parked in WIP and Outdated) =====")
    for _, name in ipairs(failedKnown) do
        table.insert(report, "  [dead] " .. name)
    end
    table.insert(report, "")
end
table.insert(report, "===== ALL OK (for reference) =====")
for _, name in ipairs(passed) do
    table.insert(report, "  [OK] " .. name)
end

local reportText = table.concat(report, "\n")

local dumpDir = "C:\\dumps"
os.execute('if not exist "' .. dumpDir .. '" mkdir "' .. dumpDir .. '"')
local tempPath = dumpDir .. "\\eldenring_aob_healthcheck.txt"
local fh = io.open(tempPath, "w")
if fh then
    fh:write(reportText)
    fh:close()
end

if showText then
    showText("AOB Health Check Results (saved to " .. tempPath .. ")", reportText)
else
    print(reportText)
end

local selfEntry = getAddressList().getMemoryRecordByID(1337318020)
local t = createTimer(getMainForm())
t.Interval = 128
t.OnTimer = function(timer)
    selfEntry.Active = false
    timer.destroy()
end
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337318033</ID>
                      <Description>"Get Module Address Range (From/To for memory dump)"</Description>
                      <Color>FF8000</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>//Module Address Range - Team Hexinton
//Checkbox utility: pops up the current eldenring.exe module's From/To address range -
//the exact values Memory Viewer -&gt; Save Memory Region needs when pulling a fresh .CEM dump.
{$LUA}
if syntaxcheck then return end
[ENABLE]
local fromAddr = getAddressSafe("eldenring.exe")
if fromAddr then
    local toAddr = fromAddr + getModuleSize("eldenring.exe")
    local msg = string.format("FROM Address:\n%X\n\nTO Address:\n%X", fromAddr, toAddr)
    writeToClipboard(string.format("%X", fromAddr) .. " " .. string.format("%X", toAddr))
    messageDialog(msg .. "\n\n(copied to clipboard as \"FROM TO\")", mtInformation, mbOK)
else
    messageDialog("eldenring.exe not found - make sure Cheat Engine is attached to the game.", mtError, mbOK)
end

local selfEntry = getAddressList().getMemoryRecordByID(1337318033)
local t = createTimer(getMainForm())
t.Interval = 128
t.OnTimer = function(timer)
    selfEntry.Active = false
    timer.destroy()
end
[DISABLE]
</AssemblerScript>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337318034</ID>
                      <Description>"Show Current Tablever"</Description>
                      <Color>FF8000</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>//Show Current Tablever - Team Hexinton
//Checkbox utility: pops up the game version this table build is pinned to (the same
//tablever [ Enable ]'s version-gate check uses), so anyone opening the table can see
//it without digging into the script.
{$LUA}
if syntaxcheck then return end
[ENABLE]
local tablever = 0x2000700010000 -- keep in sync with [ Enable ]'s tablever
local function versionString(vernum)
    return string.format("%u.%u.%u.%u",(vernum&gt;&gt;48)&amp;65535,(vernum&gt;&gt;32)&amp;65535,(vernum&gt;&gt;16)&amp;65535,vernum&amp;65535)
end
messageDialog("This table build is pinned to game version " .. versionString(tablever) .. ".", mtInformation, mbOK)

local selfEntry = getAddressList().getMemoryRecordByID(1337318034)
local t = createTimer(getMainForm())
t.Interval = 128
t.OnTimer = function(timer)
    selfEntry.Active = false
    timer.destroy()
end
[DISABLE]
</AssemblerScript>
