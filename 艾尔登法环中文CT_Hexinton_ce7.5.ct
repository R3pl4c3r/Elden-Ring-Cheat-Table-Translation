                <CheatEntry>
                  <ID>1987707200</ID>
                  <Description>"FOV &amp; Refresh Rate Change/Unlock"</Description>
                  <Options moHideChildren="1"/>
                  <Color>00FF00</Color>
                  <GroupHeader>1</GroupHeader>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>1987707202</ID>
                      <Description>"FOV Changer (Check this First)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{
  Game Executable : eldenring.exe
  Feature         : FOV Changer
  Anchored for the current game build. Multiplies the game's own FOV multiplier (normally always
  1.0) by FOV Multiplier below -- decimals like 1.3 are fine. Always resets to a safe 1.0 default on
  enable. You do NOT need to check the FOV Multiplier box below. it isn't being fought over by the
  game each frame, so just double-click its value and type/edit it directly.
}

[ENABLE]
aobscanmodule(FOV_AoB,eldenring.exe,80 BB 88 04 00 00 00 44 0F 28 E0 F3 44 0F 10 05 ?? ?? ?? ?? 45)
alloc(FOV_Newmem,$200,FOV_AoB)
alloc(FOV_Value,4)
registersymbol(FOV_AoB)
registersymbol(FOV_Value)

FOV_Value:
dd (float)1.0

FOV_Newmem:
mulss xmm0,[FOV_Value]

FOV_OriginalCode:
cmp byte ptr [rbx+488],0

FOV_Exit:
jmp FOV_Return

FOV_AoB:
jmp FOV_Newmem
nop
nop
FOV_Return:

[DISABLE]
FOV_AoB:
db 80 BB 88 04 00 00 00

unregistersymbol(FOV_AoB)
unregistersymbol(FOV_Value)
dealloc(FOV_Newmem)
dealloc(FOV_Value)
</AssemblerScript>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>1987707206</ID>
                          <Description>"Tip: Change Value of FOV Multiplier. For Example: 1.3 would be around 90 FOV. Adjust however you want."</Description>
                          <Color>008000</Color>
                          <GroupHeader>1</GroupHeader>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>1987707203</ID>
                          <Description>"FOV Multiplier"</Description>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>Float</VariableType>
                          <Address>FOV_Value</Address>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1987707204</ID>
                      <Description>"Unlock Refresh Rate (Check this First)"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{
  Game Executable : eldenring.exe
  Feature         : Unlock Refresh Rate
  Anchored for the current game build. Removes the hardcoded 60Hz-in-fullscreen lock. Refresh Rate
  Cap below is a plain number, default 60. a background timer (128ms) watches it and re-patches the
  game's frame-time the moment it changes, so picking a new option applies immediately. Pick Unlimited
  (0) to remove the frame-time target entirely. no artificial cap at all. You do NOT
  need to check the Refresh Rate Cap box below. just double-click its value/dropdown directly.
}

[ENABLE]
aobscanmodule(FrameLock_AoB,eldenring.exe,C7 ?? ?? ?? 88 88 3C EB)
aobscanmodule(HertzLock_AoB,eldenring.exe,EB ?? C7 ?? ?? 3C 00 00 00 C7 ?? ?? 01 00 00 00)
alloc(FrameLock_FPS,4)
registersymbol(FrameLock_AoB)
registersymbol(HertzLock_AoB)
registersymbol(FrameLock_FPS)

FrameLock_FPS:
dd #60

HertzLock_AoB+5:
db 00 00 00 00

HertzLock_AoB+12:
db 00 00 00 00

{$lua}
local function FrameLock_Apply(fps)
  if fps == nil then return end
  if fps == 0 then
    if fps ~= FrameLock_LastFPS then
      writeFloat(getAddress("FrameLock_AoB") + 3, 0.0)
      FrameLock_LastFPS = fps
    end
    return
  end
  if fps &lt; 1 then
    fps = 60
  elseif fps &gt; 1 and fps &lt; 30 then
    fps = 30
  elseif fps &gt; 360 then
    fps = 360
  end
  if fps ~= FrameLock_LastFPS then
    writeFloat(getAddress("FrameLock_AoB") + 3, (1000.0 / fps) / 1000.0)
    FrameLock_LastFPS = fps
  end
end

FrameLock_LastFPS = nil
FrameLock_Apply(readInteger("FrameLock_FPS"))

FrameLock_PollTimer = createTimer()
FrameLock_PollTimer.Interval = 128
FrameLock_PollTimer.OnTimer = function(timer)
  FrameLock_Apply(readInteger("FrameLock_FPS"))
end
FrameLock_PollTimer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if FrameLock_PollTimer ~= nil then
  FrameLock_PollTimer.Enabled = false
  FrameLock_PollTimer.destroy()
  FrameLock_PollTimer = nil
end
{$asm}

FrameLock_AoB+3:
db 89 88 88 3C

HertzLock_AoB+5:
db 3C 00 00 00

HertzLock_AoB+12:
db 01 00 00 00

unregistersymbol(FrameLock_AoB)
unregistersymbol(HertzLock_AoB)
unregistersymbol(FrameLock_FPS)
dealloc(FrameLock_FPS)
</AssemblerScript>
