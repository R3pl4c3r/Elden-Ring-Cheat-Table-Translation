                      <Color>0000FF</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$lua}
local tableFile=findTableFile('ciui.exe')
if tableFile then
local temppath = os.getenv("TEMP")
local inipath = temppath.."\\ciui.ini"
local memrec = getAddressList().getMemoryRecordByID(22032700)
for i=0,memrec.Count-1 do
executeCodeLocalEx("WritePrivateProfileStringW",{type=4,value="OVERLAY"},{type=4,value=memrec[i].Description},{type=4,value=memrec[i].Value},{type=4,value=inipath})
end
filename=temppath.."\\ciui.exe"
tableFile.saveToFile(filename)
ShellExecute(filename)
end
 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
{$lua}
if filename then
ShellExecute(filename,"unload")
filename=nil
end
