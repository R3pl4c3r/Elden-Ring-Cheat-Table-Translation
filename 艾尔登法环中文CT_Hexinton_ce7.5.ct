                <CheatEntry>
                  <ID>1337102522</ID>
                  <Description>"添加动作"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
alloc(GestureAdd__,512,eldenring.exe)
registersymbol(GestureAdd__)

aobscanmodule(GestureAddCall,eldenring.exe,40 55 56 57 48 83 EC 70 48 C7 44 24 50 FEFFFFFF 48 89 9C 24)
registersymbol(GestureAddCall)

alloc(GestureParamID,4)
registersymbol(GestureParamID)

GestureParamID:
 dd #110

GestureAdd__:
mov ecx,[GestureParamID]
sub rsp,28
call GestureAddCall
add rsp,28
ret


[DISABLE]
dealloc(GestureAdd__)
unregistersymbol(GestureAdd__)

unregistersymbol(GestureAddCall)

dealloc(GestureParamID)
unregistersymbol(GestureParamID)
</AssemblerScript>
