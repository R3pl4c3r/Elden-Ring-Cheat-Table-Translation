        <CheatEntry>
          <ID>1337208330</ID>
          <Description>"[ 复活NPC/BOSS，解锁地图/赐福/制作笔记/砥石刀等 ]"</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>9565</ID>
              <Description>"Flags记录器"</Description>
              <Color>3131FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local RootMemRec=getAddressList().getMemoryRecordByID(9565)
local FlagsBase=AOBScanModuleUnique("eldenring.exe","44 89 7C 24 28 4C 8B 25","+X")
FlagsBase=FlagsBase+readInteger(FlagsBase+8)+12
registerSymbol("EventFlagMan",FlagsBase,true)
local function SnapshotFlags()
    local p=readQword(FlagsBase)
    if not p then return end
    p=readQword(p+0x28)
    if not p then return end
    return readBytes(p,0x1BF9A8,true)
end

FlagsForm.LV.OnDblClick=function(sender)
    if sender.ItemIndex&lt;0 then return end
    local s=inputQuery("Description","","")
    if not s then return end
    for i=sender.Items.Count-1,0,-1 do
        if sender.Items[i].Selected then
           local memrec=getAddressList().createMemoryRecord()
           memrec.appendToEntry(RootMemRec)
           memrec.setDescription(s~="" and s or sender.Items[i].getCaption().."    "..sender.Items[i].SubItems[3].."→"..sender.Items[i].SubItems[2])
           memrec.setAddress(sender.Items[i].SubItems[0])
           memrec.Type=vtBinary
           memrec.Binary.Startbit=tonumber(sender.Items[i].SubItems[1])
           memrec.Binary.Size=1
        end
    end
end
FlagsForm.ButtonAdd.OnClick=function(sender)
   FlagsForm.LV.OnDblClick(FlagsForm.LV)
end

FlagsForm.LV.OnKeyDown=function(sender,key)
    if key==0x2E then
      sender.beginUpdate()
      for i=sender.Items.Count-1,0,-1 do
          if sender.Items[i].Selected then
             sender.Items[i].delete()
          end
      end
      sender.endUpdate()
    elseif key==67 and isKeyPressed(17) then
        local i
        local s=""
        for i=0,sender.Items.Count-1 do
            if sender.Items[i].Selected then
               s=s..sender.Items[i].getCaption()
               for j=0,sender.Items[i].SubItems.Count-1 do
                   s=s..'\t'..sender.Items[i].SubItems[j]
               end
               if i+1&lt;sender.Items.Count then
                  s=s.."\r\n"
               end
            end
        end
        if s and s:len()&gt;0 then
           writeToClipboard(s)
        end
    end
end

FlagsForm.OnClose=function(sender)
    SaveWindowState(FlagsForm, "FlagsMonitor")
    RootMemRec.Active=false
end
FlagsForm.OnResize=function(sender)
    sender.ButtonAdd.Top=sender.ClientHeight-sender.ButtonAdd.Height-2
    sender.ButtonAdd.Left=sender.ClientWidth/3-sender.ButtonAdd.Width/2
    sender.ButtonDel.Top=sender.ClientHeight-sender.ButtonDel.Height-2
    sender.ButtonDel.Left=sender.ClientWidth*2/3-sender.ButtonDel.Width/2
    sender.LV.setSize(sender.ClientWidth,sender.ButtonAdd.Top-2)
end

FlagsForm.ButtonDel.OnClick=function(sender)
    FlagsForm.LV.OnKeyDown(FlagsForm.LV,0x2E)
end

local LastFlags=SnapshotFlags()
local function CompareFlags()
    local NewFlags=SnapshotFlags()
    if not NewFlags then return end
    if not LastFlags then LastFlags=NewFlags return end
    for k,v in pairs(NewFlags) do
        if LastFlags[k]~=v then for i=0,7 do if (LastFlags[k]&amp;1&lt;&lt;i)~=(v&amp;1&lt;&lt;i) then
           local item=FlagsForm.LV.items.add()
           item.setCaption(os.date("%X"))
           item.SubItems.setText(string.format("[[EventFlagMan]+28]+%X\n%u\n%s\n%s",k-1,i,(v&amp;1&lt;&lt;i)~=0 and "True" or "False",(LastFlags[k]&amp;1&lt;&lt;i)~=0 and "True" or "False"))
        end end end
    end
    LastFlags=NewFlags
end

FlagsMonTimer=createTimer(nil,true)
FlagsMonTimer.Interval=256
FlagsMonTimer.OnTimer=function(timer)
    if not pcall(CompareFlags) then
        RootMemRec.Active=false
    end
end
LoadWindowState(FlagsForm, "FlagsMonitor", FlagsForm.Left, FlagsForm.Top, FlagsForm.Width, FlagsForm.Height)
FlagsForm.OnResize(FlagsForm)
FlagsForm.show()
[DISABLE]
{$lua}
if syntaxcheck then return end
if FlagsMonTimer then
FlagsMonTimer.destroy()
FlagsMonTimer=nil
end
FlagsForm.hide()
FlagsForm.LV.Items.clear()
</AssemblerScript>
