                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>{Author:Pavuk}
[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
{$lua}
autoAssemble([[
aobscanmodule(Finder,eldenring.exe,F3 0F 7F 4D D0 80 3D * * * * 00 74 1F BA 05)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 7) + 12
unregisterSymbol("Finder")
registerSymbol("GroupMask", addr, true)

autoAssemble([[
aobscanmodule(Finder,eldenring.exe,0F 29 74 24 40 0F 1F)
registersymbol(Finder)
]])
local addr = getAddress("Finder")
addr = addr + readInteger(addr + 12) + 16
unregisterSymbol("Finder")
registerSymbol("dHitbox", addr, true)
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
unregistersymbol(GroupMask)
unregistersymbol(dHitbox)
</AssemblerScript>
