                    <CheatEntry>
                      <ID>1337213929</ID>
                      <Description>"Infinite_Flasks"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local goods = {
      0x400003E8, --Flask of Crimson Tears
      0x400003E9, --Flask of Crimson Tears
      0x4000041A, --Flask of Cerulean Tears
      0x4000041B, --Flask of Cerulean Tears
}
for i,id in pairs(goods) do
  if(id ~= nil) then
    local good = EquipParamGoods:new("InfFlasks",id)
    good:patchBinary(0x48,0,7)
  end
end
[DISABLE]
{$lua}
if syntaxcheck then return end
paramUtils:restore("InfFlasks")
</AssemblerScript>
