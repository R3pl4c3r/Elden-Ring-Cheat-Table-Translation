                          <Description>"Refresh Rate Cap"</Description>
                          <DropDownList>60:60
144:144
165:165
240:240
0:Unlimited
</DropDownList>
                          <ShowAsSigned>0</ShowAsSigned>
                          <VariableType>4 Bytes</VariableType>
                          <Address>FrameLock_FPS</Address>
                        </CheatEntry>
                        <CheatEntry>
                          <ID>1987707201</ID>
                          <Description>"Warning: Unlimited may cause physics/animation issues at very high FPS"</Description>
                          <Color>FF8000</Color>
                          <GroupHeader>1</GroupHeader>
                        </CheatEntry>
                      </CheatEntries>
                    </CheatEntry>
