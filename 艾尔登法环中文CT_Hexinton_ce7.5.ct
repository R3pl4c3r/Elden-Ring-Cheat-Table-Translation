{$lua}
local values={}
local count=0
synchronize(function()
    local memrec=getAddressList().getMemoryRecordByID(1337318007)
    count=memrec.DropDownCount
    for i=0,count-1 do
        values[i]=tonumber(memrec.DropDownValue[i])
    end
end)
local itembuf=allocateMemory(4+16)
writeInteger(itembuf,1)
for i=0,count-1 do
    writeInteger(itembuf+4,values[i]|0x10000000)
    writeInteger(itembuf+4+4,1)
    writeInteger(itembuf+4+8,0)
    writeInteger(itembuf+4+12,-1)
    executeCode("itemgib",itembuf)
    sleep(10)
end
