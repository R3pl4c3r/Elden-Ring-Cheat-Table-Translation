</DropDownList>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>Binary</VariableType>
                      <BitStart>4</BitStart>
                      <BitLength>4</BitLength>
                      <ShowAsBinary>0</ShowAsBinary>
                      <Address>itembuffer+27</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>601066</ID>
                      <Description>"物品 ID"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>Binary</VariableType>
                      <BitStart>0</BitStart>
                      <BitLength>28</BitLength>
                      <ShowAsBinary>0</ShowAsBinary>
