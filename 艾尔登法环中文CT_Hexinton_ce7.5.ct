for i=0,count-1 do
    writeInteger(itembuf+4,values[i])
    writeInteger(itembuf+4+4,1)
    writeInteger(itembuf+4+8,0)
    writeInteger(itembuf+4+12,-1)
    executeCode("itemgib",itembuf)
    sleep(10)
end
synchronize(function()
    local t=createTimer(getMainForm())
    t.Interval=128
    t.OnTimer=function(timer)
        getAddressList().getMemoryRecordByID(1337318002).Active=false
        deAlloc(itembuf)
        timer.destroy()
    end
end)
[DISABLE]
</AssemblerScript>
