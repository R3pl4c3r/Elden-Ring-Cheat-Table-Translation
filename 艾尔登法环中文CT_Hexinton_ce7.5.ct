                <CheatEntry>
                  <ID>1337256999</ID>
                  <Description>"超级强韧度"</Description>
                  <Options moDeactivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

aobscanmodule(massive_poise,eldenring.exe,f3 0f 10 40 ? eb ? 0f 57 c0 f3 0f 58 f0) // should be unique
alloc(newmem,$1000,massive_poise)

label(code)
label(return)
label(massive_poiseread)
registersymbol(massive_poiseread)


newmem:
  db C7 40
  readmem(massive_poise+4,1)                      //mov [rax+14], (float)5 = 5000 per armor item
  db 00 00 A0 40
code:
  readmem(massive_poise,5)
  jmp return

massive_poiseread:
 readmem(massive_poise,5)

massive_poise:
  jmp newmem
return:
registersymbol(massive_poise)

[DISABLE]

massive_poise:
  readmem(massive_poiseread,5)

