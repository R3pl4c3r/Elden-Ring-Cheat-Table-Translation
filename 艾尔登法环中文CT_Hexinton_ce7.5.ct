                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

{$lua}

autoAssemble([[
aobscanmodule(CSWindowFinder,eldenring.exe,8D 50 08 B9 28 27 00 00 E8 ?? ?? ?? ?? 48 89 44 24 60 48 85 C0 74 0E 48 8D 55 A0 48 8B C8 E8 ?? ?? ?? ?? EB 03 48 8B C6 48 89 05 ?? ?? ?? ??)
registersymbol(CSWindowFinder)
]])
local addr = getAddress("CSWindowFinder")
addr = addr + 0x28
local slot = addr + 7 + readInteger(addr + 3)
unregisterSymbol("CSWindowFinder")
registerSymbol("CSWindow", readPointer(slot), true)

[DISABLE]

{$lua}
unregisterSymbol("CSWindow")
