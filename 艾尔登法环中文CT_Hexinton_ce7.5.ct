                    <CheatEntry>
                      <ID>1337256955</ID>
                      <Description>"在屏幕下方显示放大的血条 作者：Pavuk"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
alloc(DisplayBossHpBar,512,eldenring.exe)
aobscanmodule(DisplayFunc,eldenring.exe,25 EC 48 89 5C 24 08) // should be unique
aobscanmodule(DisplayDisableFunc,eldenring.exe,A7 40 53 48 83 EC 20 8B D9) // should be unique

alloc(PlayerID,4)
registersymbol(PlayerID) //2003[11]

PlayerID:
 dd #10000

label(Disable)
label(Exit)

createthread(DisplayBossBar)

DisplayBossBar:
sub rsp,48

mov eax,1 //1 - enable, 0 disable
cmp eax,0
je Disable
mov edx,1 //slot number
mov r8d,0 //name id
lea rcx,[PlayerID]
call DisplayFunc //enable call
jmp Exit

Disable:
mov ecx,1 //slot number
call DisplayDisableFunc+1 //disable call
Exit:
add rsp,48
ret

[DISABLE]
dealloc(DisplayBossBar)

dealloc(PlayerID)
unregistersymbol(PlayerID)
</AssemblerScript>
                    </CheatEntry>
