              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(ItemSpawn_,512,eldenring.exe)
registersymbol(ItemSpawn_)

label(Weapon)
label(Armor)
label(Talisman)
label(Goods)
label(AshOfWar)
label(Code_)

aobscanmodule(Item_AddCall_,eldenring.exe,4055 56 57 4154 4155 4156 4157 488DAC24 ???????? 48 81 EC ???????? 48 C7 45 C8 ???????? 48 89 9C 24 ???????? 48 8B 05 ???????? 48 33 C4 48 89 85 ???????? 44 89 4C 24 ?? 4D 8B F8)
registersymbol(Item_AddCall_)

alloc(ItemSpawnData,16)
registersymbol(ItemSpawnData)

alloc(ItemSpawnData2,4)
registersymbol(ItemSpawnData2)

alloc(ItemCategory,4)
registersymbol(ItemCategory)

ItemCategory:
  dd 04

ItemSpawnData:
dd #01
dd #150 //itemid
dd #01 //item count

ItemSpawnData2:
dd FFFFFFFF //durability?

ItemSpawn_:
cmp [ItemCategory],0
je Weapon
cmp [ItemCategory],1
je Armor
cmp [ItemCategory],2
je Talisman
cmp [ItemCategory],4
je Goods
cmp [ItemCategory],8
je AshOfWar
jmp Code_

Weapon:

mov eax,0
jmp Code_

Armor:
mov eax,10000000
jmp Code_

Talisman:
mov eax,20000000
jmp Code_

Goods:
mov eax,40000000
jmp Code_

AshOfWar:
mov eax,80000000
jmp Code_

Code_:
sub rsp,40

xor r9d,r9d //display type
mov r15d,[ItemSpawnData+04]
add [ItemSpawnData+04],eax
lea rdx,[ItemSpawnData]
lea r8,[ItemSpawnData2]
mov rcx,[MapItemMan]
push r15
call Item_AddCall_
pop r15
mov [ItemSpawnData+04],r15d
add rsp,40
ret


[DISABLE]
dealloc(ItemSpawn_)
unregistersymbol(ItemSpawn_)

dealloc(ItemSpawnData)
unregistersymbol(ItemSpawnData)

dealloc(ItemSpawnData2)
unregistersymbol(ItemSpawnData2)

dealloc(ItemCategory)
unregistersymbol(ItemCategory)
