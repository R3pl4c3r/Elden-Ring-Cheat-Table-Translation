                <CheatEntry>
                  <ID>1337214603</ID>
                  <Description>"应用效果 ApplyEffect"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
Let's see how long it would take for a notorious Chinese guy (KOKO?) to plagiarize this,
who allegedly collaborated with Phokz to make the ds3 table while phokz doesn't even
know who he is.
Seems this cutie is really into copying our team members' work and claiming him as the creator
, since 2016.
It's not easy to disgust so many people, tbh.

Imagine wrapping everything in a jank exe generated by CE that can be REd easily,
fantasizing none shall be able to see the code that he blatantly copied.
No one would mind if he credited proper people, but this guy really likes to claim himself
as the one and only author.

The spirit of CTs is to encourage innovations and promote vitality in ER's modding community,
otherwise we would just make some trainers with advanced tech to protect them from being cracked.

Anyway, plagiarism entails risks, I don't think such an inexperienced and unskilled guy can understand tho.
}
[enable]
aobscanmodule(ApplyEffectAOBFecth,Eldenring.exe,48 89 6C 24 10 48 89 74 24 18 57 41 56 41 57 48 83 EC 60 0F B6 84 24 B0 00 00 00 49 8B F1 88 44 24 20 4D 8B F0 8B EA 4C 8B F9 E8 ? ? ? ? 84 C0 0F 84 ? ? ? ? 48 83 CF FF 48 89 9C 24 80 00 00 00 48 8B DF)
registersymbol(ApplyEffectAOBFecth)
alloc(ApplyEffect,$128,Eldenring.exe)
registersymbol(ApplyEffect)
alloc(Effect_ID,4)
registersymbol(Effect_ID)
ApplyEffect:
 sub   rsp, 38
 mov   rax, WorldChrMan
 mov   rcx, [rax]
 mov   rcx, [rcx+1E508]
 mov   rcx, [rcx+178]
 mov   eax, [Effect_ID]
 mov   edx, eax
 mov   rax, WorldChrMan
 mov   r8,  [rax]
 mov   r8,  [r8+1E508]
 mov   r9,   r8
 mov   [rsp+20], 3F800000
 call  ApplyEffectAOBFecth
 add   rsp, 38
 ret
Effect_ID:
 dd #110
[disable]
dealloc(ApplyEffect)
unregistersymbol(ApplyEffect)
dealloc(Effect_ID)
unregistersymbol(Effect_ID)
unregistersymbol(ApplyEffectAOBFecth)
</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>1337214604</ID>
                      <Description>"效果 Effect"</Description>
                      <ShowAsSigned>0</ShowAsSigned>
                      <VariableType>4 Bytes</VariableType>
                      <Address>Effect_ID</Address>
                    </CheatEntry>
                    <CheatEntry>
                      <ID>1337214605</ID>
                      <Description>"应用 Apply_Effect"</Description>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[enable]
{$lua}
function disableSelf(timer)
  timer.destroy()
  local addr=getAddressList().getMemoryRecordByDescription("Apply_Effect")
  memoryrecord_unfreeze(addr)
end
local t=createTimer(nil)
t.OnTimer=disableSelf
t.Interval=100
t.Enabled=true
{$asm}
CREATETHREAD(ApplyEffect)
[disable]
</AssemblerScript>
