                      <AssemblerScript>{Author:Pavuk Edited by Pyre}
[ENABLE]
aobscanmodule(CharInitFunc,eldenring.exe,48 8B C4 57 48 83 EC 70 48 C7 40 ? FE FF FF FF 48 89 58 ? 48 89 68 ? 48 89 70 ? 8B F2 48 8B E9)
registersymbol(CharInitFunc)
alloc(CharaInitSwap,512,eldenring.exe)
registersymbol(CharaInitSwap)
alloc(CharaInitParamID,4)
