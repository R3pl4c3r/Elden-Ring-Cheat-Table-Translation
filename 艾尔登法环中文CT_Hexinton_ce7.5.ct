                                      <AssemblerScript>[ENABLE]
//Fixed By LukeYui
alloc(Animtest,512,eldenring.exe)
registersymbol(Animtest)

alloc(T_AnimationID,8)
registersymbol(T_AnimationID)

T_AnimationID:
  dd #3000
  dd 0

Animtest:
sub rsp,48

mov ecx,#34
mov rdx,eldenring.exe+3D778C8 //?AVhkLifoAllocator + 0x8 SCAN
call TlsSetValue

mov rcx,[SpawnedEnemy]
mov rcx,[rcx+190]
mov rcx,[rcx+28]
lea rcx,[rcx+17B0]
lea rdx,[T_AnimationID]
mov r8d,[T_AnimationID+04] //IsLoop?

call "eldenring.exe"+415640
add rsp,48
ret

[DISABLE]
dealloc(Animtest)
unregistersymbol(Animtest)

dealloc(T_AnimationID)
unregistersymbol(T_AnimationID)

</AssemblerScript>
