                <CheatEntry>
                  <ID>601336</ID>
                  <Description>"文本提取"</Description>
                  <Options moHideChildren="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$asm}
aobScanModule(StringTableBaseAOB,eldenring.exe,48 8B ?? ?? ?? ?? 03 44 0F B6 30 48 85 FF 75)
aobScanModule(SearchStringTable,eldenring.exe,3B 51 10 73 29 44 3B 41 14 73 23 48 8B 41 08 8B D2 48 8B 0C D0 48 85 C9 74 14 41 8B C0 48 8B 0C C1 48 85 C9)
alloc(StringDumper,4096)
label(StringTableIndex)
label(StringDumpFileName)
label(loopstart)
label(loopend)
label(exit2)
label(exit1)
label(exit)
label(format)
registerSymbol(StringDumper)
registerSymbol(StringTableIndex)
registerSymbol(StringDumpFileName)
define(buf,40)
define(len,270)
StringDumper:
mov	r11,rsp
push r15
sub	rsp,260
mov rax,StringTableBaseAOB+3
mov r15,StringTableBaseAOB+7
movsxd rax,DWORD PTR [rax]
mov	r15,[rax+r15]

mov	[r11-20],r12
lea	rcx,[StringDumpFileName]
xor	r12d,r12d
mov	[r11-28],r14
mov	[rsp+30],r12
xor	r9d,r9d
mov	[rsp+28],r12d
mov	edx,100002
mov	DWORD PTR[rsp+20],2
lea	r8d,[r12+7]
call CreateFileW
mov	r14,rax
cmp	rax,#-1
je exit1

mov	[rsp+278],rbx
xor ebx,ebx
mov	[rsp+280],rbp
mov	[rsp+258],rsi
mov	[rsp+250],rdi
mov	edi,r12d



mov rcx,[r15+8]
test rcx,10000
jl exit2
mov rcx,[rcx]
test rcx,10000
jl exit2
mov	r8d,[StringTableIndex]
mov rdi,[rcx+r8*8]
test rdi,10000
jl exit2

loopstart:

lea edx,[rbx*8]
add edx,edx
mov esi,[rdi+rdx+20]

xor	edx, edx
mov	r8d,[StringTableIndex]
mov	r9d,esi
mov	rcx,r15
call SearchStringTable
mov	rbp,rax

test rax,rax
je loopnext


mov	r9d,esi
lea	r8,[format]
mov	edx,200
lea	rcx,[rsp+buf]
call sprintf_s
cmp eax,0
jle loopnext

mov	ecx, eax
lea	rdx, [rsp+buf]
add	rdx, rcx
mov	[rsp+38], r12
mov	r8d,#508
mov	[rsp+30], r12
sub	r8d,eax
mov	[rsp+len], eax
mov	[rsp+28], r8d
mov	r9d,#-1
mov	[rsp+20], rdx
mov	r8, rbp
xor	edx, edx
mov	ecx,#65001
call WideCharToMultiByte
cmp eax,0
jle loopnext
dec eax
mov	edx,[rsp+len]

lea	r9,[rsp+len]
add	edx,eax
mov	[rsp+20], r12
mov	rcx, r14
mov	BYTE PTR [rsp+rdx+buf],#13
inc	edx
lea	r8d,[rdx+1]
mov	BYTE PTR[rsp+rdx+buf],#10
lea	rdx,[rsp+buf]
mov	[rsp+len], r8d
call WriteFile

loopnext:
inc	ebx
cmp	ebx,[rdi+C]
jl loopstart
loopend:
mov	rdi,[rsp+250]
mov	rsi,[rsp+258]
mov	rbp,[rsp+280]

exit2:
mov	rcx,r14
call CloseHandle
mov	rbx,[rsp+278]
exit1:
mov	r12,[rsp+248]
mov	r14,[rsp+240]
exit:
add	rsp,260
pop	r15
ret
align 4
StringTableIndex:
dd 0
format:
db '%','u',9,0
StringDumpFileName:
dw 0
{$lua}
createTimer(1,function(t)
writeInteger("StringTableIndex",1)
local fn=os.getenv("TEMP").."\\stringdump.txt"
local StringDumpFileName=getAddressSafe("StringDumpFileName")
if StringDumpFileName then
   writeString(StringDumpFileName,fn,true)
   writeSmallInteger(StringDumpFileName+fn:len()*2,0)
end
end)
[DISABLE]
{$asm}
unregisterSymbol(StringDumper)
unregisterSymbol(StringTableIndex)
unregisterSymbol(StringDumpFileName)
dealloc(StringDumper)
</AssemblerScript>
