                  <Description>"无限跳（骑马也可以）"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanmodule(horse_jump,eldenring.exe,88 87 ? ? ? ? 48 8b 83 ? ? ? ? 48 8b 48 ? 80 b9) // should be unique
alloc(newmem1,$100,horse_jump)
aobscanmodule(inf_horse_two,eldenring.exe,88 87 ? ? ? ? 48 8b 83 ? ? ? ? 48 8b 48 ? e8 ? ? ? ? 88 87) // should be unique
alloc(newmem,$1000,inf_horse_two)
aobscanmodule(InfJump,eldenring.exe,83 EC ?? 80 B9 D1 01 00 00 00 74 ?? 48) // should be unique
alloc(codejump,$10,InfJump)

registersymbol(InfJump)
registersymbol(codejump)

label(code1)
label(return1)
label(horse_jumpread)
registersymbol(horse_jumpread)
label(code)
label(return)
label(inf_horse_tworead)
registersymbol(inf_horse_tworead)

codejump:
   InfJump+9:
	db 92

newmem1:
  mov al,1
code1:
  readmem(horse_jump,6)
  jmp return1

horse_jumpread:
 readmem(horse_jump,6)

newmem:
  mov al,1
code:
  readmem(inf_horse_two,6)
  jmp return

inf_horse_tworead:
 readmem(inf_horse_two,6)

horse_jump:
  jmp newmem1
  nop
return1:
registersymbol(horse_jump)

inf_horse_two:
  jmp newmem
  nop
return:
registersymbol(inf_horse_two)


[DISABLE]
InfJump+9:
	db 00
horse_jump:
  readmem(horse_jumpread,6)
inf_horse_two:
  readmem(inf_horse_tworead,6)

unregistersymbol(*)
dealloc(*)
