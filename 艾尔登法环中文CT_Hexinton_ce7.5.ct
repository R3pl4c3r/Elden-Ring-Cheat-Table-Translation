                  <Description>"无限灵药圣杯瓶"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{ Game   : eldenring.exe
  Version: 
  Date   : 2022-03-01
  Author : Limno

  This script does blah blah blah
}

[ENABLE]
aobscanmodule(buffsj,eldenring.exe,f3 0f 11 43 ? 48 8d 4b ? e8 ? ? ? ? 80 63) // should be unique
alloc(newmem,$1000,buffsj)

label(code)
label(return)

newmem:
cmp r10d,ff
jne code
cmp r11d,ffffffff
jne code

movss xmm6,[rbx+40]
comiss xmm6,[rbx+48]
je code

mov rcx,[rdi+10]
cmp dword [rcx+c],ffffffff
jne code

movss xmm6,[rbx+48]
comiss xmm6,[exit2]
jb code

mov rcx,[rbx]
cmp dword [rcx+128],1f9
je code

movss xmm0,[rbx+48]
movss [rbx+44],xmm0
jmp return

code:
movss [rbx+44],xmm0
jmp return

exit2:
dd (float)10.0

buffsj:
jmp newmem
return:
