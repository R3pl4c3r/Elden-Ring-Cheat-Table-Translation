alloc(newmem,$1000,camaddr)
registersymbol(camadr)
registersymbol(startfreecam)

label(code)
label(return)

newmem:
  mov [camadr],rdi
code:
  cmp byte ptr [startfreecam],1
  jne @f
  movaps [rdi],xmm6
@@:
  cmp byte ptr [rbx+00000315],00
  jmp return
camadr:
dq 0
startfreecam:
db 1
camaddr:
  jmp newmem
  nop 5
return:
