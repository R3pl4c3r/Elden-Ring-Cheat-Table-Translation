                    <CheatEntry>
                      <ID>1987705439</ID>
                      <Description>"Spawn Debug Character"</Description>
                      <Color>800080</Color>
                      <VariableType>Auto Assembler Script</VariableType>
                      <AssemblerScript>[ENABLE]
{$asm}
alloc(CreateChr_,256,eldenring.exe)
registersymbol(CreateChr_)

createthread(CreateChr_)

CreateChr_:

mov rax,[WorldChrMan]
mov rax,[rax+1E648]
mov byte ptr [rax+44],01
mov edx,[DbgChrCount]
mov [SpawnedEnemy+10],edx
imul edx,edx,10
mov rbx,[SpawnedEnemy+8]
add rbx,rdx
mov al,[rax+178]
mov [rbx+0B],al
inc [DbgChrCount]

ret
{$lua}
disableMemrec(memrec)
{$asm}
[DISABLE]
{$asm}
unregistersymbol(CreateChr_)
dealloc(CreateChr_)
</AssemblerScript>
