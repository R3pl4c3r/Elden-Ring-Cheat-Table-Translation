            <CheatEntry>
              <ID>1337309266</ID>
              <Description>"铃珠（孪生老妪商店）"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337309321</ID>
                  <Description>"以下选项的数值代表孪生老妪是否收到铃珠"</Description>
                  <Color>008000</Color>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337309322</ID>
                  <Description>"--------------------------------------------------"</Description>
                  <GroupHeader>1</GroupHeader>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337309333</ID>
                  <Description>"移除/添加 所有铃珠"</Description>
                  <Color>4080FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Made by Zei
[ENAble]
//Removes all Bearings from Husk
{$asm}
[[EventFlagMan]+28]+153A6D:
dd #0
[[EventFlagMan]+28]+153A6E:
dd #0
[[EventFlagMan]+28]+153A6F:
dd #0
[[EventFlagMan]+28]+153A70:
dd #0
[[EventFlagMan]+28]+153A71:
dd #0
[[EventFlagMan]+28]+153A72:
dd #0
[[EventFlagMan]+28]+153A73:
dd #0
[[EventFlagMan]+28]+153A74:
dd #0
[DISABLE]
//Adds all Bearings to Husk
{$asm}
[[EventFlagMan]+28]+153A6D:
dd #255
[[EventFlagMan]+28]+153A6E:
dd #255
[[EventFlagMan]+28]+153A6F:
dd #255
[[EventFlagMan]+28]+153A70:
dd #255
[[EventFlagMan]+28]+153A71:
dd #255
[[EventFlagMan]+28]+153A72:
dd #255
[[EventFlagMan]+28]+153A73:
dd #255
[[EventFlagMan]+28]+153A74:
dd #255


</AssemblerScript>
                </CheatEntry>
