        <CheatEntry>
          <ID>1337193332</ID>
          <Description>"[ 功能脚本 ]"</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>1337304907</ID>
              <Description>"[ 主要 ]"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337291933</ID>
                  <Description>"激活所有召唤池"</Description>
                  <Options moHideChildren="1" moActivateChildrenAsWell="1"/>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
aobscanmodule(EventFlag_C1,eldenring.exe,48 89 5C 24 08 48 89 74 24 18 57 48 83 EC 30 48 8B DA 41 0F B6 F8 8B 12 48 8B F1 85 D2 0F 84 ?? ?? ?? ??)
registersymbol(EventFlag_C1)

alloc(SetSignPuddleFlags,512,eldenring.exe)
registersymbol(SetSignPuddleFlags)

label(Loop1)
label(SetEventFlag)

alloc(EventFlagID_Puddle,4)
registersymbol(EventFlagID_Puddle)

createthread(SetSignPuddleFlags)

SetSignPuddleFlags:
xor ecx,ecx
mov r15d,40

mov rax,[PARAM] // PARAM
mov rax,[rax+30A0]
mov rax,[rax+80]
mov rax,[rax+80]
Loop1:
movzx ebx,word ptr [rax+0A]
lea rdx,[rax+r15d]

mov r13d,[rdx]
mov r11d,[rdx+08]
lea r12,[rax+r11d]

push rax
push rcx
push r15
call SetEventFlag
pop r15
pop rcx
pop rax

lea r15d,[r15+18]
inc ecx
cmp ecx,ebx
jl Loop1
ret

SetEventFlag:
mov rcx,[EventFlagMan] //"eldenring.exe"+3C672A8 EventFlagMan
mov r8l,01
lea rdx,[EventFlagID_Puddle]
mov [rdx],r13d

sub rsp,28
call EventFlag_C1
add rsp,28
ret

[DISABLE]
dealloc(SetSignPuddleFlags)
unregistersymbol(SetSignPuddleFlags)

dealloc(EventFlagID_Puddle)
unregistersymbol(EventFlagID_Puddle)

unregistersymbol(EventFlag_C1)
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337114344</ID>
                  <Description>"解锁所有赐福/地图/制作书等（包含DLC内容）"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>//Credits Script : Pav; EventFlagIds: Vawser
[ENABLE]
aobscanmodule(EventFlag_C1,eldenring.exe,48 89 5C 24 08 48 89 74 24 18 57 48 83 EC 30 48 8B DA 41 0F B6 F8 8B 12 48 8B F1 85 D2 0F 84 ?? ?? ?? ??)
registersymbol(EventFlag_C1)

alloc(EventFlagUnlocker,2048,eldenring.exe)
registersymbol(EventFlagUnlocker)

label(Loop1)
label(Loop2)

label(PARAM_1)
label(MAP_1)
label(BASIC_1)
label(CookBook_1)
label(Whetblade_1)

label(PresetEventFlag)
label(SetEventFlag)

alloc(EventFlagID,4)
registersymbol(EventFlagID)

alloc(Map_Ids,$84)
registersymbol(Map_Ids)

alloc(Mechanic_Ids,$50)
registersymbol(Mechanic_Ids)

alloc(Whetblade_Ids,$24)
registersymbol(Whetblade_Ids)

alloc(Cookbook_Ids,$240)
registersymbol(Cookbook_Ids)

Map_Ids:
  dd #62010 #62011 #62012 #62020 #62021 #62022 #62030 #62031 #62032 #62040 #62041 #62050 #62051 #62052 #62060 #62061 #62062 #62063 #62064 #82001

Mechanic_Ids:
  dd #60020 //flask of wondrous physick
  dd #60100 //Torrent Whistle
  dd #60110 //Spirit Calling Bell
  dd #60120 //Crafting Kit
  dd #60130 //Whetstone Knife
  dd #60140 //Tailoring Tools
  dd #60150 //Golden Tailoring Tools

Whetblade_Ids:
  dd #65610 #65640 #65660 #65680 #65720

Cookbook_Ids:
  //Nomadic Warrior's
  dd #67000 #67110 #67010 #67080
  dd #67830 #67020 #67050 #67880
  dd #67430 #67030 #67220 #67060
  dd #67080 #67870 #67900 #67290
  dd #67100 #67270 #67070 #67230
  dd #67120 #67890 #67090 #67910
  //Armorer's
  dd #67200 #67210 #67280 #67260 #27310 #67300 #67250
  //Glintstone Craftman's
  dd #67410 #67450 #67480 #67400 #67420 #67460 #67470 #67440
  //Missionary's
  dd #67610 #67600 #67650 #67640 #67630 #67130 #68230
  //Ancient Dragon Apostle's
  dd #68000 #68010 #68020 #68030
  //Perfumer's
  dd #67840 #67850 #67860 #67920
  //Fevor's
  dd #68200 #68220 #68210
  //Frenzied's
  dd #68400 #68410

createthread(EventFlagUnlocker)

EventFlagUnlocker:
PARAM_1: //Unlock all Bonfires
xor ecx,ecx
mov r15d,40

mov rax,[PARAM] //"eldenring.exe"+3C80158 PARAM
mov rax,[rax+CA0]
mov rax,[rax+80]
mov rax,[rax+80]
Loop1:
movzx ebx,word ptr [rax+0A]
lea rdx,[rax+r15d]

mov r11d,[rdx+08]
lea r12,[rax+r11d]
mov r13d,[r12+04]

push rax
push rcx
push r15
call SetEventFlag
pop r15
pop rcx
pop rax

lea r15d,[r15+18]
inc ecx
cmp ecx,ebx
jl Loop1

MAP_1: //Unlock All Map
mov ebx,#20 //Loop Max Index
lea rdx,[Map_Ids] //Our Flags
call PresetEventFlag


BASIC_1: //Unlock basic mechanics
mov ebx,#8
lea rdx,[Mechanic_Ids]
call PresetEventFlag

Whetblade_1: //Unlock all Whetblades

mov ebx,#5
lea rdx,[Whetblade_Ids]
call PresetEventFlag

CookBook_1: //Unlock all cookbooks
mov ebx,#59
lea rdx,[Cookbook_Ids]
call PresetEventFlag

ret

PresetEventFlag:
xor ecx,ecx
Loop2:
lea rax,[rcx*4]
lea r14,[rdx+rax]
mov r13d,[r14]

push rax
push rcx
push rbx
push rdx
call SetEventFlag
pop rdx
pop rbx
pop rcx
pop rax

inc ecx
cmp ecx,ebx
jl Loop2
ret

SetEventFlag:
mov rcx,[EventFlagMan] //"eldenring.exe"+3C672A8 EventFlagMan
mov r8l,01
lea rdx,[EventFlagID]
mov [rdx],r13d

sub rsp,28
call EventFlag_C1
add rsp,28
ret


[DISABLE]
dealloc(EventFlagUnlocker)
unregistersymbol(EventFlagUnlocker)

