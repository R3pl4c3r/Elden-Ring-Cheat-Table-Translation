local function TableFromMemRec(rec)
    local tbl={}
    local i
    for i=0,rec.DropDownCount-1 do
        tbl[rec.DropDownValue[i]]=rec.DropDownDescription[i]
    end
    return tbl
end

local WeaponNames=TableFromMemRec(getAddressList().getMemoryRecordByID(601247))
local ArmorNames=TableFromMemRec(getAddressList().getMemoryRecordByID(601250))
local RingNames=TableFromMemRec(getAddressList().getMemoryRecordByID(601059))
local GoodsNames=TableFromMemRec(getAddressList().getMemoryRecordByID(601301))
local MagicNames=TableFromMemRec(getAddressList().getMemoryRecordByID(601305))
local GemNames=TableFromMemRec(getAddressList().getMemoryRecordByID(83064))

InventoryForm.EditFind.OnKeyDown=function(sender,key)
    if key==13 and sender.Text:len()&gt;0 then
        local items=InventoryForm.LV.Items
        local ff=-1
        local i
        local findstr=sender.Text:upper()
        for i=0,items.Count-1 do
            local found=items[i].getCaption():upper():find(findstr)
            if not found and items[i].SubItems.Count&gt;0 then
               found=items[i].SubItems[0]:upper():find(findstr)
            end
            if not found and items[i].SubItems.Count&gt;1 then
               found=items[i].SubItems[1]:upper():find(findstr)
            end
            if not found and items[i].SubItems.Count&gt;2 then
               found=items[i].SubItems[2]:upper():find(findstr)
            end
            if not found and items[i].SubItems.Count&gt;3 then
               found=items[i].SubItems[3]:upper():find(findstr)
            end
            if found then
                if ff&lt;0 then
                   ff=i
                end
                items[i].Selected=true
            else
                items[i].Selected=false
            end
        end
        if ff&gt;=0 then
           sendMessage(InventoryForm.LV.Handle,4115,ff,0)
        end
    end
end
InventoryForm.OnClose=function(sender)
    SaveWindowState(InventoryForm, "InventoryEditor")
    getAddressList().getMemoryRecordByID(83062).Active=false
end
InventoryForm.OnResize=function(sender)
    sender.ButtonChange.Top=sender.ClientHeight-sender.ButtonChange.Height
    sender.ButtonChange.Left=sender.ClientWidth/3-sender.ButtonChange.Width/2
    sender.ButtonDelete.Top=sender.ClientHeight-sender.ButtonDelete.Height
    sender.ButtonDelete.Left=sender.ClientWidth*2/3-sender.ButtonDelete.Width/2

    sender.EditCount.Width=sender.ClientWidth-sender.EditCount.Left
    sender.EditCount.Top=sender.ButtonChange.Top-sender.EditCount.Height
    sender.LabelCount.Top=sender.EditCount.Top+(sender.EditCount.Height-sender.LabelCount.Height)/4

    sender.EditID.Width=sender.ClientWidth-sender.EditID.Left
    sender.EditID.Top=sender.EditCount.Top-sender.EditID.Height-2
    sender.LabelID.Top=sender.EditID.Top+(sender.EditID.Height-sender.LabelID.Height)/4

    sender.EditFind.Width=sender.ClientWidth-sender.EditFind.Left
    sender.EditFind.Top=sender.EditID.Top-sender.EditFind.Height-2
    sender.LabelFind.Top=sender.EditFind.Top+(sender.EditFind.Height-sender.LabelFind.Height)/4
    sender.LV.setSize(sender.ClientWidth,sender.EditFind.Top-2)
end

InventoryForm.LV.OnSelectItem=function(sender)
    local item=sender.Selected
    local b1,b2
    if item then
        InventoryForm.EditID.Text=item.getCaption()
        if item.SubItems.Count&gt;=3 then
            InventoryForm.EditCount.Text=item.SubItems[1]
        end
         local id1=readInteger(item.Data)
         local id2=readInteger(item.Data+4)
         if id1 and id2 then
            b2=true
            if id1&amp;0xFFFFFFF==id2&amp;0xFFFFFFF then
               b1=true
            end
         end
    else
        InventoryForm.EditID.Text=""
        InventoryForm.EditCount.Text=""
    end
    InventoryForm.ButtonChange.Enabled=b1
    InventoryForm.EditID.ReadOnly=not b1
    InventoryForm.EditCount.ReadOnly=not b1
    InventoryForm.ButtonDelete.Enabled=b2
end

InventoryForm.ButtonChange.OnClick=function(sender)
    local item=InventoryForm.LV.Selected
    local newid=tonumber(InventoryForm.EditID.Text)
    if item and newid then
       local id
       writeInteger(item.Data,readInteger(item.Data)&amp;0xF0000000|newid)
       writeInteger(item.Data+4,readInteger(item.Data+4)&amp;0xF0000000|newid)
       writeInteger(item.Data+8,tonumber(InventoryForm.EditCount.Text))
       pcall(UpdateInventory)
    end
end
InventoryForm.ButtonDelete.OnClick=function(sender)
    local items=InventoryForm.LV.Items
    local i
    for i=0,items.Count-1 do
        if items[i].Selected then
           writeBytes(items[i].Data,0,0,0,0,255,255,255,255,0,0,0,0,0,0,0,0,255,255,255,255)
        end
    end
    pcall(UpdateInventory)
    InventoryForm.LV.ItemIndex=-1
    InventoryForm.LV.OnSelectItem(InventoryForm.LV)
end

function UpdateInventoryWorker(inv,j,hasupdate)
    if not inv then
       return j,update
    end
    local n
    n=readInteger(inv-8)
    if not n then
       return j,update
    end
    local i
    local items=InventoryForm.LV.getItems()
    local chgacc=0
    for i=0,n-1 do
        local x=readQword(inv+i*24+4)
        if not x then return j,update end
        local id=x&amp;0xFFFFFFFF
        local count=x&gt;&gt;32
        if not id or not count or chgacc&gt;768 then
           break
        end
        if id~=0 and id~=0xFFFFFFFF and count&gt;0 then
          local kind=(id&amp;0xF0000000)&gt;&gt;28
          id=id&amp;0xFFFFFFF
          local item
          local changed=false
          if j&lt;items.Count then
             item=items[j]
          else
             if not hasupdate then
                hasupdate=true
                InventoryForm.LV.beginUpdate()
             end
             item=items.add()
             changed=true
          end

          item.Data=inv+i*24
          local s=tostring(id)
          if s~=item.getCaption() then
             item.setCaption(s)
             changed=true
          end
          local name=""
          if kind==0 then
             s="Weapon"
             local l=id%100
             name=WeaponNames[tostring(id-l)]
             if not name then
                name="?WeaponName?"
             end
             if l~=0 then
                name=name..' + '..tostring(l)
             end
          elseif kind==1 then
             s="Armor"
             name=ArmorNames[tostring(id)]
             if not name then
                name="?ProtectorName?"
             end
          elseif kind==2 then
             s="Talisman"
             name=RingNames[tostring(id)]
             if not name then
                name="?AccessoryName?"
             end
          elseif kind==8 then
             s="Ash of War"
             name=GemNames[tostring(id)]
          else
             s="Magic"
             name=MagicNames[tostring(id)]
             if not name then
                s="Goods"
                name=GoodsNames[tostring(id)]
                if not name then
                    name="?GoodsName?"
                end
             end
          end
          if item.SubItems.Count&lt;1 then
              item.SubItems.add(s)
              changed=true
          elseif item.SubItems[0]~=s then
              item.SubItems[0]=s
              changed=true
          end

          s=tostring(count)
          if item.SubItems.Count&lt;2 then
              item.SubItems.add(s)
              changed=true
          elseif item.SubItems[1]~=s then
              item.SubItems[1]=s
              changed=true
          end

          if item.SubItems.Count&lt;3 then
              item.SubItems.add(name)
              changed=true
          elseif item.SubItems[2]~=name then
              item.SubItems[2]=name
              changed=true
          end
          if changed then
             chgacc=chgacc+1
          end
          j=j+1
        end
    end
    return j,hasupdate
end

function UpdateInventory()
    local j=0
    local sel=InventoryForm.LV.ItemIndex
    local hasupdate=false
    j,hasupdate=UpdateInventoryWorker(readQword("InventoryAddr"),j,hasupdate)
    j,hasupdate=UpdateInventoryWorker(readQword("InventoryAddr+8"),j,hasupdate)
    j,hasupdate=UpdateInventoryWorker(readQword("InventoryAddr+10"),j,hasupdate)
    local items=InventoryForm.LV.getItems()
    if j&lt;items.Count then
       if not hasupdate then
          hasupdate=true
          InventoryForm.LV.beginUpdate()
       end
       for i=items.Count-1,j,-1 do
           items[i].delete()
       end
    end
    if sel&gt;=0 and sel&lt;items.Count then
       InventoryForm.LV.ItemIndex=sel
    end
    if hasupdate then
       InventoryForm.LV.endUpdate()
    end
end

InventoryUpdateTimer=createTimer(nil,true)
InventoryUpdateTimer.Interval=1024
InventoryUpdateTimer.OnTimer=function(timer)
    if not pcall(UpdateInventory) then
        getAddressList().getMemoryRecordByID(83062).Active=false
    end
end

InventoryUpdateTimer.OnTimer(InventoryUpdateTimer)
LoadWindowState(InventoryForm, "InventoryEditor", InventoryForm.Left, InventoryForm.Top, InventoryForm.Width, InventoryForm.Height)
InventoryForm.OnResize(InventoryForm)
InventoryForm.show()
[DISABLE]
{$lua}
if InventoryUpdateTimer then
   InventoryUpdateTimer.destroy()
   InventoryUpdateTimer=nil
end
InventoryForm.hide()
InventoryForm.LV.getItems().clear()
InventoryForm.EditFind.Text=""
InventoryForm.EditID.Text=""
InventoryForm.EditCount.Text=""
InventoryForm.ButtonChange.Enabled=false
InventoryForm.EditID.ReadOnly=true
InventoryForm.EditCount.ReadOnly=true
InventoryForm.ButtonDelete.Enabled=false
