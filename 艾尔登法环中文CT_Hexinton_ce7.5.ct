  mov [rdx+20],rsi             //current
  mov rsi, [rdx+40]            //max
  mov [rdx+24],rsi             //current
  mov rsi, [rdx+44]            //max
  mov [rdx+28],rsi             //current
code:
  pop rsi
  pop rdx
  readmem(resistandmore,8)
  jmp return

resistandmoreread:
 readmem(resistandmore,8)

set_res_current:
 dd 0

resistandmore:
  jmp newmem
  nop 3
return:
registersymbol(resistandmore)

