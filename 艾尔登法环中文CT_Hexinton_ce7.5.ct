            <CheatEntry>
              <ID>1337193447</ID>
              <Description>"肢体动作（(Broken bc of DLC)）"</Description>
              <Options moHideChildren="1"/>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>1337193498</ID>
                  <Description>"Unlock All Regular Gestures"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local gestures = {
	1, -- Bow
	3, -- Polite Bow
	5, -- My Thanks
	7, -- Curtsy
	9, -- Reverential Bow
	11, -- My Lord
	13, -- Warm Welcome
	15, -- Wave
	17, -- Casual Greeting
	19, -- Strength!
	21, -- As You Wish
	41, -- Point Forwards
	43, -- Point Upwards
	45, -- Point Downwards
	47, -- Beckon
	49, -- Wait
	51, -- Calm Down!
	61, -- Nod In Thought
	81, -- Extreme Repentance
	83, -- Grovel For Mercy
	101, -- Rallying Cry
	103, -- Heartening Cry
	105, -- By My Sword
	107, -- Hoslow's Oath
	109, -- Fire Spur Me
	110, -- The Carian Oath, cut content
	121, -- Bravo
	141, -- Jump For Joy
	143, -- Triumphant Delight
	145, -- Fancy Spin
	147, -- Finger Snap
	161, -- Dejection
	181, -- Patches' Crouch
	183, -- Crossed Legs
	185, -- Rest
	187, -- Sitting Sideways
	189, -- Dozing Cross-Legged
	191, -- Spread Out
	192, -- Fetal Position, cut content
	195, -- Balled Up
	197, -- What Do You Want?
	201, -- Prayer
	203, -- Desperate Prayer
	205, -- Rapture
	207, -- Erudition
	209, -- Outer Order
	211, -- Inner Order
	213, -- Golden Order Totality
	216, -- The Ring (Pre-order)
	218, -- The Ring
}

local GameDataMan = readPointer("GameDataMan")
local CsDlc = readPointer("CsDlc")
local PlayerGameData = readPointer(GameDataMan + 8)
local GestureGameData = readPointer(PlayerGameData + 0x8D8)

-- The Ring pre-order gesture
if readByte(CsDlc + 0x10) == 1 then
	gestures[50] = 217
else
	gestures[51] = 219
end

for i,v in ipairs(gestures) do
	writeInteger(GestureGameData + 4 + i * 4, v)
end

disableMemrec(memrec)

[DISABLE]

</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337273102</ID>
                  <Description>"Unlock All Shadow of the Erdtree Gestures"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local gestures = {
    223, -- May the Best Win
    225, -- The Two Fingers
    226, -- Ring of Miquella (Pre-order)
    229, -- Let Us Go Together
    231, -- O Mother
    232, -- Ring of Miquella
}

local GameDataMan = readPointer("GameDataMan")
local CsDlc = readPointer("CsDlc")
local PlayerGameData = readPointer(GameDataMan + 8)
local GestureGameData = readPointer(PlayerGameData + 0x8D8)

if readByte(CsDlc + 0x11) ~= 1 then
    local e = "You do not own Shadow of the Erdtree."
    ShowMessage(e)
    error(e, 2)
elseif readByte(CsDlc + 0x12) == 1 then
    gestures[3] = 227
else
    gestures[6] = 233
end

for i,v in ipairs(gestures) do
    writeInteger(GestureGameData + 0xD0 + i * 4, v)
end

disableMemrec(memrec)

[DISABLE]
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>1337193518</ID>
                  <Description>"Unlock Cut Gestures"</Description>
                  <Color>0000C8</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local gestures = {
	221,
	193,
	111,
}

local GameDataMan = readPointer("GameDataMan")
local CsDlc = readPointer("CsDlc")
local PlayerGameData = readPointer(GameDataMan + 8)
local GestureGameData = readPointer(PlayerGameData + 0x8D8)

-- The Ring pre-order gesture
if readByte(CsDlc + 0x10) == 1 then
	gestures[50] = 217
else
	gestures[51] = 219
end

for i,v in ipairs(gestures) do
	writeInteger(GestureGameData + 4 + i * 4, v)
end

disableMemrec(memrec)

[DISABLE]

</AssemblerScript>
